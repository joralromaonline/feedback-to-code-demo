# Copy to .env. Values marked CHANGE_ME are local placeholders, never production secrets.
NODE_ENV=development
PORT=3001
PUBLIC_API_ORIGIN=http://localhost:3001
CORS_ORIGINS=http://localhost:3000

# Docker/PostgreSQL
POSTGRES_DB=feedback
POSTGRES_USER=feedback
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DATABASE_PASSWORD
DATABASE_URL=postgres://feedback:CHANGE_ME_LOCAL_DATABASE_PASSWORD@localhost:5432/feedback

# Redis and S3-compatible object storage
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=feedback-screenshots
S3_ACCESS_KEY=CHANGE_ME_LOCAL_MINIO_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_LOCAL_MINIO_SECRET_KEY
S3_FORCE_PATH_STYLE=true
# Use AES256 only when the S3-compatible server has SSE-S3 configured.
S3_SERVER_SIDE_ENCRYPTION=none

# Service/project
INTERNAL_SERVICE_TOKEN=CHANGE_ME_AT_LEAST_16_CHARACTERS
PUBLIC_DEMO_PROJECT_KEY=pk_CHANGE_ME_PUBLIC_INGEST_KEY
INTEGRATION_MODE=mock
LLM_PROVIDER=nvidia
WORKER_MAX_CONCURRENCY=1
WORKSPACE_ROOT=/tmp/feedback-workspaces
COMMAND_TIMEOUT_MS=120000
ALLOW_NETWORK_INSTALL=false
MOCK_TARGET_REPO=tests/fixtures/repo-basic
AUTO_MIGRATE=false
LOG_LEVEL=info

# OpenAI server-only. Used when INTEGRATION_MODE=real and LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_TIMEOUT_MS=120000
OPENAI_MAX_AGENT_TURNS=40
OPENAI_REASONING_EFFORT=medium

# NVIDIA NIM server-only. Used when INTEGRATION_MODE=real and LLM_PROVIDER=nvidia.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro
NVIDIA_TIMEOUT_MS=60000
NVIDIA_CLASSIFICATION_TIMEOUT_MS=90000
NVIDIA_AGENT_TIMEOUT_MS=600000
NVIDIA_MAX_AGENT_TURNS=12
NVIDIA_MAX_OUTPUT_TOKENS=4096
# DeepSeek V4 Pro accepts none, high or max. none matches NVIDIA's non-thinking snippet.
NVIDIA_REASONING_EFFORT=none

# GitHub App server-only. Required only when INTEGRATION_MODE=real.
GITHUB_APP_ID=
# base64 of the PEM file, e.g. base64 < private-key.pem | tr -d '\n'
GITHUB_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=
GITHUB_INSTALLATION_ID=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BASE_BRANCH=main
GITHUB_API_VERSION=2026-03-10

# Demo browser. These are public by design and never contain server credentials.
NEXT_PUBLIC_FEEDBACK_API_URL=http://localhost:3001
NEXT_PUBLIC_FEEDBACK_PROJECT_KEY=pk_CHANGE_ME_PUBLIC_INGEST_KEY
NEXT_PUBLIC_FEEDBACK_ENVIRONMENT=development
NEXT_PUBLIC_FEEDBACK_ENABLED=true
NEXT_PUBLIC_APP_REVISION=demo-local
