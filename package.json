{
  "name": "feedback-to-code-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "tsx apps/api/src/server.ts",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:worker": "tsx watch apps/worker/src/production.ts",
    "dev:demo": "next dev demo-app -p 3000",
    "worker": "tsx apps/worker/src/production.ts",
    "demo:flow": "tsx scripts/demo-flow.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "docker:up": "docker-compose up --build -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f api worker demo",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "build": "tsc --noEmit && next build demo-app"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@octokit/app": "^16.1.2",
    "@octokit/rest": "^22.0.1",
    "bullmq": "^6.0.5",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.0",
    "fastify-raw-body": "^5.0.0",
    "html2canvas": "^1.4.1",
    "ioredis": "^6.0.0",
    "next": "^16.2.12",
    "openai": "^7.3.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tsx": "^4.23.1",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
